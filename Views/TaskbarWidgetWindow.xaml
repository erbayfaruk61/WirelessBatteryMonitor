<Window x:Class="WirelessBatteryMonitor.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Border x:Name="RootBorder"
            Background="#DD1C1E26"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,4"
            Cursor="Hand">
        <ItemsControl x:Name="DevicesItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center" ToolTip="{Binding TooltipText}">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{Binding AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ChargingIcon}"
                                   FontSize="11"
                                   Foreground="#60A5FA"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ChargingVisibility}"
                                   Margin="0,0,2,0" />
                        <TextBlock Text="{Binding PercentText}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
