<Window x:Class="WirelessBatteryMonitor.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="405"
        MaxHeight="610"
        SizeToContent="Height"
        Deactivated="Window_Deactivated">
    <Border Background="#F5181A22"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <StackPanel>
            <!-- Üst Başlık -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kablosuz Pil İzleyici"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Cihazlar taranıyor..."
                               FontSize="11.5"
                               Foreground="#9CA3AF"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Width="32"
                        Height="32"
                        Margin="0,0,6,0"
                        Background="#1FFFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Şimdi Yenile"
                        Click="RefreshButton_Click" />
                <Button Grid.Column="2"
                        x:Name="SettingsToggleButton"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Width="32"
                        Height="32"
                        Background="#1FFFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Ayarlar"
                        Click="SettingsToggleButton_Click" />
            </Grid>

            <!-- Cihaz Listesi Paneli -->
            <ScrollViewer x:Name="DevicesPanel"
                          MaxHeight="450"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateText"
                               Text="Görüntülenecek kablosuz cihaz bulunamadı."
                               TextWrapping="Wrap"
                               Foreground="#9CA3AF"
                               FontSize="12.5"
                               Margin="0,20"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="DeviceCardsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Üst Satır -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="8" Background="#1FFFFFFF" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="{Binding AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MetaText}"
                                                           FontSize="11"
                                                           Foreground="#9CA3AF"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="⚡"
                                                           FontSize="13"
                                                           Foreground="#60A5FA"
                                                           Visibility="{Binding ChargingVisibility}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,3,0" />
                                                <TextBlock Text="{Binding PercentText}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Tag="{Binding Key}"
                                                    Content="&#xE70F;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Width="26"
                                                    Height="26"
                                                    Background="Transparent"
                                                    Foreground="#9CA3AF"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Cihazı özelleştir (isim ve uyarı eşiği)"
                                                    Click="EditDevice_Click" />

                                            <Button Grid.Column="4"
                                                    Tag="{Binding Key}"
                                                    Content="{Binding VisibilityGlyph}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Width="26"
                                                    Height="26"
                                                    Background="Transparent"
                                                    Foreground="#9CA3AF"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Görev çubuğunda gizle / göster"
                                                    Click="ToggleDeviceVisibility_Click" />
                                        </Grid>

                                        <!-- Alt Pil Dağılımı (Sol/Sağ/Kutu) -->
                                        <TextBlock Text="{Binding SubBatteriesText}"
                                                   Visibility="{Binding SubBatteriesVisibility}"
                                                   FontSize="11.5"
                                                   Foreground="#93C5FD"
                                                   Margin="44,4,0,0" />

                                        <!-- İlerleme Çubuğu -->
                                        <ProgressBar Value="{Binding ProgressValue}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,10,0,6"
                                                     Background="#26FFFFFF"
                                                     Foreground="{Binding AccentBrush}"
                                                     BorderThickness="0" />

                                        <!-- Alt Satır: Tahmini Süre ve Sparkline -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FooterText}"
                                                       FontSize="11"
                                                       Foreground="#9CA3AF"
                                                       VerticalAlignment="Center" />
                                            <Polyline Grid.Column="1"
                                                      Points="{Binding SparklinePoints}"
                                                      Stroke="{Binding AccentBrush}"
                                                      StrokeThickness="1.5"
                                                      Width="72"
                                                      Height="18"
                                                      Visibility="{Binding SparklineVisibility}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Cihaz Özelleştirme Paneli -->
            <StackPanel x:Name="DeviceEditPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="Cihaz Özelleştirme" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
                <TextBlock Text="Özel Cihaz Adı (boş bırakılırsa varsayılan kullanılır)" Foreground="#D1D5DB" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="EditCustomNameBox" Height="28" Padding="6,4" Background="#26FFFFFF" Foreground="White" BorderBrush="#44FFFFFF" Margin="0,0,0,10" />

                <CheckBox x:Name="EditUseCustomThresholdCheck" Content="Bu cihaz için özel düşük pil eşiği kullan"
                          Foreground="#E5E7EB" Margin="0,0,0,6" Checked="EditCustomThresholdCheck_Changed" Unchecked="EditCustomThresholdCheck_Changed" />
                <TextBlock x:Name="EditThresholdLabel" Text="Özel Eşik: %15" Foreground="#D1D5DB" FontSize="12" />
                <Slider x:Name="EditThresholdSlider" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                        Margin="0,4,0,14" ValueChanged="EditThresholdSlider_ValueChanged" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Width="80" Height="30" Margin="0,0,8,0" Background="#26FFFFFF" Foreground="White" BorderThickness="0" Click="CancelEditDevice_Click" />
                    <Button Content="Kaydet" Width="80" Height="30" Background="#2563EB" Foreground="White" BorderThickness="0" Click="SaveEditDevice_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Uygulama İçi Ayarlar Paneli -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" MaxHeight="450" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,4,4,0">
                    <TextBlock Text="Genel Ayarlar" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />

                    <TextBlock x:Name="PollIntervalLabel" Text="Yenileme Sıklığı: 30 sn" Foreground="#D1D5DB" FontSize="12" />
                    <Slider x:Name="PollIntervalSlider" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                            Margin="0,4,0,8" ValueChanged="PollIntervalSlider_ValueChanged" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LowThresholdLabel" Text="Düşük Eşik: %30" Foreground="#D1D5DB" FontSize="11.5" />
                            <Slider x:Name="LowThresholdSlider" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Margin="0,4,0,0" ValueChanged="LowThresholdSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="CriticalThresholdLabel" Text="Kritik Eşik: %10" Foreground="#FCA5A5" FontSize="11.5" />
                            <Slider x:Name="CriticalThresholdSlider" Minimum="5" Maximum="30" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Margin="0,4,0,0" ValueChanged="CriticalThresholdSlider_ValueChanged" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="NotificationsCheck" Content="Düşük pilde Windows bildirimi gönder"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="TrayIconCheck" Content="Sistem tepsisi pil simgesini göster"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="TaskbarWidgetCheck" Content="Görev çubuğu widget'ını göster"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="AllMonitorsCheck" Content="Tüm monitörlerin görev çubuklarında göster"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="ShowDisconnectedCheck" Content="Aktif bağlı olmayan cihazları göster"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="RememberChargeCheck" Content="Bağlantısı kesilen cihazların son şarjını hatırla"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="SubBatteriesCheck" Content="Kulaklık Sol/Sağ/Kutu alt pil detayını göster"
                              Foreground="#E5E7EB" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="StartupCheck" Content="Windows ile birlikte otomatik başlat"
                              Foreground="#E5E7EB" Margin="0,0,0,12" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" />

                    <TextBlock Text="Aktif Sürücü Modülleri" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <CheckBox x:Name="ReaderCorsairCheck" Content="Corsair" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderSteelSeriesCheck" Content="SteelSeries" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderLogitechCheck" Content="Logitech HID++" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderRazerCheck" Content="Razer" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderHyperXCheck" Content="HyperX" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderPlayStationCheck" Content="PlayStation" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderXboxCheck" Content="Xbox / XInput" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderBluetoothCheck" Content="Bluetooth" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                        <CheckBox x:Name="ReaderBleGattCheck" Content="BLE GATT (TWS)" Foreground="#E5E7EB" Margin="0,2" Checked="ReaderCheck_Changed" Unchecked="ReaderCheck_Changed" />
                    </UniformGrid>

                    <TextBlock Text="Cihaz Görünürlüğü (Panel &amp; Görev Çubuğu)" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                    <ItemsControl x:Name="DeviceVisibilityList" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          Tag="{Binding Key}"
                                          IsChecked="{Binding IsVisible, Mode=OneWay}"
                                          Foreground="#E5E7EB"
                                          Margin="0,2"
                                          Checked="DevicePanelVisibility_Changed"
                                          Unchecked="DevicePanelVisibility_Changed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="CopyReportButton"
                            Content="Yeni Cihaz İçin HID/USB Raporu Kopyala"
                            Height="32"
                            Background="#26FFFFFF"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CopyReportButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
